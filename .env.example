# Database connection (SQLite for local dev, PostgreSQL for production deployment)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for Vercel/Supabase/Neon:
# DATABASE_URL="postgresql://user:password@host:5432/abbay_command_center?sslmode=require"

# AI Provider Configuration ('auto', 'gemini', 'openai', 'anthropic', 'groq', 'ollama')
AI_PROVIDER="auto"

# Optional External AI API Keys (leave blank to run with built-in intelligent engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Application Settings
NEXT_PUBLIC_APP_NAME="Abbay AI Command Center"
